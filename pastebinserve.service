[Unit]
Description=Pastebin Service
After=network.target

[Service]
Restart=always
ExecStart=/usr/local/bin/pastebinserve
WorkingDirectory=/etc/pastebinserve

# Defaults; override in /etc/pastebinserve/.env
Environment=PORT=3333
Environment=STORAGE_PATH=/var/lib/pastebinserve

# Optional env file (won't fail if missing).
# Put PORT / STORAGE_PATH / GIT_REMOTE overrides here.
EnvironmentFile=-/etc/pastebinserve/.env

[Install]
WantedBy=multi-user.target
